generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  ADMIN
}

enum SystemRole {
  ADMIN
  SUPPORT
  MODERATOR
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum WeddingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentPublicationStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum WeddingVisibility {
  PUBLIC
  PASSWORD_PROTECTED
  INVITE_ONLY
}

enum WeddingMemberRole {
  OWNER
  EDITOR
  GUEST_MANAGER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum WeddingSurface {
  ONLINE_INVITATION
  WEDDING_WEBSITE
  RECAP
}

enum TemplateProductType {
  ONLINE_INVITATION
  WEDDING_WEBSITE
  RECAP
}

enum TemplateStyleStatus {
  ACTIVE
  ARCHIVED
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  RETIRED
}

enum TemplateSourceStatus {
  DEVELOPMENT
  REVIEW
  READY
  DEPRECATED
}

enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
  FAILED
}

enum AttendanceStatus {
  ATTENDING
  DECLINED
  MAYBE
}

enum WishStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
  HIDDEN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ChecklistStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum GiftType {
  MONEY
  GOLD
  PHYSICAL_GIFT
}

enum GiftReceiveMethod {
  CASH
  BANK_TRANSFER
  PHYSICAL_GIFT
  OTHER
}

enum ReciprocityStatus {
  PENDING
  RETURNED
  NOT_APPLICABLE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique @db.VarChar(320)
  emailVerifiedAt     DateTime?                @db.Timestamptz(3)
  passwordHash        String?                  @db.VarChar(255)
  displayName         String?                  @db.VarChar(120)
  phone               String?                  @db.VarChar(32)
  avatarUrl           String?                  @db.VarChar(2048)
  locale              String                   @default("vi-VN") @db.VarChar(16)
  timezone            String                   @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  status              UserStatus               @default(PENDING_VERIFICATION)
  platformRole        PlatformRole             @default(USER)
  lastLoginAt         DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?                @db.Timestamptz(3)
  accounts            Account[]
  sessions            Session[]
  memberships         WeddingMember[]
  createdWeddings     Wedding[]                @relation("WeddingCreator")
  completedTasks      WeddingTask[]            @relation("TaskCompletedBy")
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  auditLogs           AuditLog[]
  ownedMusicTracks    MusicTrack[]             @relation("MusicTrackOwner")
  uploadedMusicTracks MusicTrack[]             @relation("MusicTrackUploader")
  roles               UserRole[]               @relation("UserRoles")
  grantedRoles        UserRole[]               @relation("GrantedUserRoles")

  @@index([status, createdAt])
}

model UserRole {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  role        SystemRole
  grantedById String?    @db.Uuid
  grantedAt   DateTime   @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime?  @db.Timestamptz(3)
  revokedAt   DateTime?  @db.Timestamptz(3)
  reason      String?    @db.VarChar(500)
  user        User       @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?      @relation("GrantedUserRoles", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId, role, revokedAt])
  @@index([role, expiresAt, revokedAt])
  @@index([grantedById])
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String   @db.VarChar(64)
  providerAccountId String   @db.VarChar(255)
  type              String   @db.VarChar(32)
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         Int?
  tokenType         String?  @db.VarChar(32)
  scope             String?  @db.Text
  idToken           String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  sessionHash String    @unique @db.VarChar(255)
  expiresAt   DateTime  @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(3)
  ipHash      String?   @db.VarChar(128)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model VerificationToken {
  id         String              @id @default(uuid()) @db.Uuid
  identifier String              @db.VarChar(320)
  purpose    VerificationPurpose
  tokenHash  String              @unique @db.VarChar(255)
  expiresAt  DateTime            @db.Timestamptz(3)
  usedAt     DateTime?           @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  @@index([identifier, purpose, expiresAt])
}

model Wedding {
  id                 String                     @id @default(uuid()) @db.Uuid
  createdById        String                     @db.Uuid
  name               String                     @db.VarChar(160)
  slug               String?                    @db.VarChar(64)
  status             WeddingStatus              @default(DRAFT)
  visibility         WeddingVisibility          @default(PUBLIC)
  accessPasswordHash String?                    @db.VarChar(255)
  timezone           String                     @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  locale             String                     @default("vi-VN") @db.VarChar(16)
  primaryDate        DateTime?                  @db.Timestamptz(3)
  revision           Int                        @default(1)
  publishedAt        DateTime?                  @db.Timestamptz(3)
  archivedAt         DateTime?                  @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?                  @db.Timestamptz(3)
  createdBy          User                       @relation("WeddingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members            WeddingMember[]
  events             WeddingEvent[]
  content            WeddingContent[]
  snapshots          PublishedWeddingSnapshot[]
  mediaAssets        MediaAsset[]
  guestCategories    GuestCategory[]
  guestGroups        GuestGroup[]
  guests             Guest[]
  rsvpResponses      RsvpResponse[]
  wishes             Wish[]
  tasks              WeddingTask[]
  giftLedgerEntries  GiftLedgerEntry[]
  auditLogs          AuditLog[]

  @@unique([slug])
  @@index([createdById, status])
  @@index([status, primaryDate])
}

model WeddingMember {
  id            String            @id @default(uuid()) @db.Uuid
  weddingId     String            @db.Uuid
  userId        String            @db.Uuid
  role          WeddingMemberRole
  status        MembershipStatus  @default(ACTIVE)
  invitedAt     DateTime?         @db.Timestamptz(3)
  joinedAt      DateTime?         @db.Timestamptz(3)
  revokedAt     DateTime?         @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  wedding       Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedTasks WeddingTask[]     @relation("TaskAssignee")

  @@unique([weddingId, userId])
  @@index([userId, status])
  @@index([weddingId, role, status])
}

model WeddingEvent {
  id             String               @id @default(uuid()) @db.Uuid
  weddingId      String               @db.Uuid
  name           String               @db.VarChar(160)
  eventType      String               @db.VarChar(48)
  startsAt       DateTime             @db.Timestamptz(3)
  endsAt         DateTime?            @db.Timestamptz(3)
  timezone       String               @db.VarChar(64)
  venueName      String?              @db.VarChar(200)
  addressLine    String?              @db.VarChar(500)
  mapUrl         String?              @db.VarChar(2048)
  latitude       Decimal?             @db.Decimal(9, 6)
  longitude      Decimal?             @db.Decimal(9, 6)
  sortOrder      Int                  @default(0)
  isPublic       Boolean              @default(true)
  revision       Int                  @default(1)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?            @db.Timestamptz(3)
  wedding        Wedding              @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  rsvpSelections RsvpEventSelection[]
  tasks          WeddingTask[]

  @@index([weddingId, startsAt])
}

model WeddingContent {
  id                String                   @id @default(uuid()) @db.Uuid
  weddingId         String                   @db.Uuid
  surface           WeddingSurface
  templateVersionId String?                  @db.Uuid
  schemaVersion     Int                      @default(1)
  content           Json
  themeConfig       Json                     @default("{}")
  sectionConfig     Json                     @default("{}")
  status            ContentPublicationStatus @default(DRAFT)
  publishedAt       DateTime?                @db.Timestamptz(3)
  revision          Int                      @default(1)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  wedding           Wedding                  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  templateVersion   TemplateVersion?         @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  mediaItems        RecapMediaItem[]
  wishSelections    RecapWishSelection[]
  snapshots         PublishedRecapSnapshot[]

  @@unique([weddingId, surface])
  @@index([templateVersionId])
}

model Template {
  id          String              @id @default(uuid()) @db.Uuid
  key         String              @unique @db.VarChar(80)
  name        String              @db.VarChar(160)
  productType TemplateProductType
  status      TemplateStatus      @default(DRAFT)
  description String?             @db.Text
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  versions    TemplateVersion[]
  styles      TemplateStyleAssignment[]
}

model TemplateStyle {
  id          String                    @id @default(uuid()) @db.Uuid
  key         String                    @unique @db.VarChar(80)
  name        String                    @db.VarChar(120)
  description String?                   @db.Text
  sortOrder   Int                       @default(0)
  status      TemplateStyleStatus       @default(ACTIVE)
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(3)
  templates   TemplateStyleAssignment[]
}

model TemplateStyleAssignment {
  templateId String        @db.Uuid
  styleId    String        @db.Uuid
  template   Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  style      TemplateStyle @relation(fields: [styleId], references: [id], onDelete: Restrict)

  @@id([templateId, styleId])
  @@index([styleId])
}

model TemplateVersion {
  id                    String                     @id @default(uuid()) @db.Uuid
  templateId            String                     @db.Uuid
  version               String                     @db.VarChar(32)
  configHash            String                     @db.VarChar(128)
  templateConfigVersion Int
  contentSchemaVersion  Int
  rendererApiVersion    Int
  codeRevision          String                     @db.VarChar(128)
  config                Json
  sourceStatus          TemplateSourceStatus       @default(REVIEW)
  releasedAt            DateTime?                  @db.Timestamptz(3)
  deprecatedAt          DateTime?                  @db.Timestamptz(3)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  template              Template                   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  contentSelections     WeddingContent[]
  weddingSnapshots      PublishedWeddingSnapshot[]
  recapSnapshots        PublishedRecapSnapshot[]

  @@unique([templateId, version])
  @@unique([templateId, configHash])
}

model PublishedWeddingSnapshot {
  id                   String          @id @default(uuid()) @db.Uuid
  weddingId            String          @db.Uuid
  templateVersionId    String          @db.Uuid
  version              Int
  surface              WeddingSurface
  slug                 String          @db.VarChar(64)
  payload              Json
  payloadHash          String          @db.VarChar(128)
  contentSchemaVersion Int
  rendererApiVersion   Int
  publishedAt          DateTime        @default(now()) @db.Timestamptz(3)
  unpublishedAt        DateTime?       @db.Timestamptz(3)
  wedding              Wedding         @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  templateVersion      TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@unique([weddingId, surface, version])
  @@index([slug, surface, unpublishedAt])
}

model MediaAsset {
  id           String           @id @default(uuid()) @db.Uuid
  weddingId    String           @db.Uuid
  uploadedById String?          @db.Uuid
  storageKey   String           @unique @db.VarChar(512)
  originalName String?          @db.VarChar(255)
  mimeType     String           @db.VarChar(128)
  sizeBytes    BigInt
  width        Int?
  height       Int?
  status       MediaStatus      @default(PENDING_UPLOAD)
  checksum     String?          @db.VarChar(128)
  altText      String?          @db.VarChar(500)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?        @db.Timestamptz(3)
  wedding      Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  variants     MediaVariant[]
  recapItems   RecapMediaItem[]

  @@index([weddingId, status, createdAt])
}

model MediaVariant {
  id           String     @id @default(uuid()) @db.Uuid
  mediaAssetId String     @db.Uuid
  variantKey   String     @db.VarChar(48)
  storageKey   String     @unique @db.VarChar(512)
  mimeType     String     @db.VarChar(128)
  sizeBytes    BigInt
  width        Int?
  height       Int?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, variantKey])
}

model GuestCategory {
  id        String          @id @default(uuid()) @db.Uuid
  weddingId String          @db.Uuid
  parentId  String?         @db.Uuid
  name      String          @db.VarChar(120)
  depth     Int
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?       @db.Timestamptz(3)
  wedding   Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  parent    GuestCategory?  @relation("GuestCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  GuestCategory[] @relation("GuestCategoryTree")
  guests    Guest[]

  @@index([weddingId, parentId, sortOrder])
}

model GuestGroup {
  id        String    @id @default(uuid()) @db.Uuid
  weddingId String    @db.Uuid
  name      String    @db.VarChar(120)
  note      String?   @db.Text
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  wedding   Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guests    Guest[]

  @@index([weddingId, name])
}

model Guest {
  id                String            @id @default(uuid()) @db.Uuid
  weddingId         String            @db.Uuid
  categoryId        String?           @db.Uuid
  groupId           String?           @db.Uuid
  name              String            @db.VarChar(160)
  slug              String            @db.VarChar(80)
  displayName       String?           @db.VarChar(160)
  phone             String?           @db.VarChar(32)
  email             String?           @db.VarChar(320)
  note              String?           @db.Text
  tableName         String?           @db.VarChar(120)
  maxPartySize      Int               @default(1)
  tags              String[]          @default([])
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?         @db.Timestamptz(3)
  wedding           Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category          GuestCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  group             GuestGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  rsvpResponses     RsvpResponse[]
  wishes            Wish[]
  giftLedgerEntries GiftLedgerEntry[]

  @@index([weddingId, groupId])
  @@index([weddingId, categoryId])
  @@unique([weddingId, slug])
  @@index([weddingId, name])
}

model RsvpResponse {
  id              String               @id @default(uuid()) @db.Uuid
  weddingId       String               @db.Uuid
  guestId         String?              @db.Uuid
  attendance      AttendanceStatus
  partySize       Int
  mealPreference  String?              @db.VarChar(160)
  specialRequest  String?              @db.Text
  message         String?              @db.Text
  submittedAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  revision        Int                  @default(1)
  wedding         Wedding              @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest           Guest?               @relation(fields: [guestId], references: [id], onDelete: SetNull)
  eventSelections RsvpEventSelection[]
  companions      RsvpCompanion[]

  @@unique([weddingId, guestId])
  @@index([weddingId, attendance, submittedAt])
}

model RsvpEventSelection {
  id             String       @id @default(uuid()) @db.Uuid
  rsvpResponseId String       @db.Uuid
  weddingEventId String       @db.Uuid
  attending      Boolean      @default(true)
  rsvpResponse   RsvpResponse @relation(fields: [rsvpResponseId], references: [id], onDelete: Cascade)
  weddingEvent   WeddingEvent @relation(fields: [weddingEventId], references: [id], onDelete: Cascade)

  @@unique([rsvpResponseId, weddingEventId])
  @@index([weddingEventId])
}

model RsvpCompanion {
  id             String       @id @default(uuid()) @db.Uuid
  rsvpResponseId String       @db.Uuid
  displayName    String       @db.VarChar(160)
  mealPreference String?      @db.VarChar(160)
  sortOrder      Int          @default(0)
  rsvpResponse   RsvpResponse @relation(fields: [rsvpResponseId], references: [id], onDelete: Cascade)

  @@index([rsvpResponseId, sortOrder])
}

model Wish {
  id              String               @id @default(uuid()) @db.Uuid
  weddingId       String               @db.Uuid
  guestId         String?              @db.Uuid
  authorName      String               @db.VarChar(160)
  content         String               @db.Text
  status          WishStatus           @default(PENDING)
  isPinned        Boolean              @default(false)
  submittedAt     DateTime             @default(now()) @db.Timestamptz(3)
  moderatedAt     DateTime?            @db.Timestamptz(3)
  deletedAt       DateTime?            @db.Timestamptz(3)
  wedding         Wedding              @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest           Guest?               @relation(fields: [guestId], references: [id], onDelete: SetNull)
  recapSelections RecapWishSelection[]

  @@index([weddingId, status, submittedAt])
}

model TaskChecklistTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  key       String              @db.VarChar(80)
  version   Int
  name      String              @db.VarChar(160)
  status    ChecklistStatus     @default(DRAFT)
  locale    String              @default("vi-VN") @db.VarChar(16)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  items     TaskChecklistItem[]

  @@unique([key, version])
}

model TaskChecklistItem {
  id                   String                @id @default(uuid()) @db.Uuid
  checklistTemplateId  String                @db.Uuid
  title                String                @db.VarChar(200)
  description          String?               @db.Text
  priority             TaskPriority          @default(MEDIUM)
  relativeDueDayOffset Int?
  sortOrder            Int                   @default(0)
  checklistTemplate    TaskChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@index([checklistTemplateId, sortOrder])
}

model WeddingTask {
  id                    String         @id @default(uuid()) @db.Uuid
  weddingId             String         @db.Uuid
  eventId               String?        @db.Uuid
  parentTaskId          String?        @db.Uuid
  assigneeMemberId      String?        @db.Uuid
  completedById         String?        @db.Uuid
  sourceTemplateKey     String?        @db.VarChar(80)
  sourceTemplateVersion Int?
  title                 String         @db.VarChar(200)
  description           String?        @db.Text
  dueAt                 DateTime?      @db.Timestamptz(3)
  priority              TaskPriority   @default(MEDIUM)
  status                TaskStatus     @default(TODO)
  sortOrder             Int            @default(0)
  completedAt           DateTime?      @db.Timestamptz(3)
  revision              Int            @default(1)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?      @db.Timestamptz(3)
  wedding               Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  event                 WeddingEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  parentTask            WeddingTask?   @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks            WeddingTask[]  @relation("TaskHierarchy")
  assigneeMember        WeddingMember? @relation("TaskAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  completedBy           User?          @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([weddingId, status, dueAt])
  @@index([weddingId, eventId, status])
  @@index([weddingId, parentTaskId, status])
  @@index([weddingId, assigneeMemberId, status])
}

model GiftLedgerEntry {
  id                       String            @id @default(uuid()) @db.Uuid
  weddingId                String            @db.Uuid
  guestId                  String?           @db.Uuid
  guestDisplayNameSnapshot String            @db.VarChar(160)
  giftType                 GiftType
  amountMinor              BigInt?
  currency                 String?           @db.Char(3)
  goldWeight               Decimal?          @db.Decimal(12, 4)
  goldUnit                 String?           @db.VarChar(32)
  goldType                 String?           @db.VarChar(64)
  giftDescription          String?           @db.Text
  receiveMethod            GiftReceiveMethod
  receivedAt               DateTime          @db.Timestamptz(3)
  note                     String?           @db.Text
  reciprocityStatus        ReciprocityStatus @default(PENDING)
  returnedAt               DateTime?         @db.Timestamptz(3)
  revision                 Int               @default(1)
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime?         @db.Timestamptz(3)
  wedding                  Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest                    Guest?            @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([weddingId, guestId])
  @@index([weddingId, reciprocityStatus, receivedAt])
}

model RecapMediaItem {
  id           String         @id @default(uuid()) @db.Uuid
  contentId    String         @db.Uuid
  mediaAssetId String         @db.Uuid
  caption      String?        @db.VarChar(500)
  sortOrder    Int            @default(0)
  content      WeddingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([contentId, mediaAssetId])
  @@index([contentId, sortOrder])
}

model RecapWishSelection {
  id        String         @id @default(uuid()) @db.Uuid
  contentId String         @db.Uuid
  wishId    String         @db.Uuid
  sortOrder Int            @default(0)
  content   WeddingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  wish      Wish           @relation(fields: [wishId], references: [id], onDelete: Restrict)

  @@unique([contentId, wishId])
  @@index([contentId, sortOrder])
}

model PublishedRecapSnapshot {
  id                String          @id @default(uuid()) @db.Uuid
  contentId         String          @db.Uuid
  templateVersionId String          @db.Uuid
  version           Int
  slug              String          @db.VarChar(64)
  payload           Json
  payloadHash       String          @db.VarChar(128)
  publishedAt       DateTime        @default(now()) @db.Timestamptz(3)
  unpublishedAt     DateTime?       @db.Timestamptz(3)
  content           WeddingContent  @relation(fields: [contentId], references: [id], onDelete: Restrict)
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@unique([contentId, version])
  @@index([slug, unpublishedAt])
}

model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  eventKey  String              @db.VarChar(100)
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey, channel])
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  eventKey  String              @db.VarChar(100)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  payload   Json
  sentAt    DateTime?           @db.Timestamptz(3)
  readAt    DateTime?           @db.Timestamptz(3)
  failedAt  DateTime?           @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  weddingId    String?  @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @db.VarChar(80)
  resourceId   String?  @db.VarChar(128)
  requestId    String?  @db.VarChar(128)
  reason       String?  @db.VarChar(500)
  metadata     Json?
  occurredAt   DateTime @default(now()) @db.Timestamptz(3)
  actorUser    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  wedding      Wedding? @relation(fields: [weddingId], references: [id], onDelete: SetNull)

  @@index([weddingId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @db.VarChar(80)
  aggregateId   String       @db.VarChar(128)
  eventType     String       @db.VarChar(120)
  eventVersion  Int          @default(1)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  lockedAt      DateTime?    @db.Timestamptz(3)
  lockedBy      String?      @db.VarChar(128)
  processedAt   DateTime?    @db.Timestamptz(3)
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  scope          String            @db.VarChar(160)
  keyHash        String            @db.VarChar(128)
  requestHash    String            @db.VarChar(128)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  resourceType   String?           @db.VarChar(80)
  resourceId     String?           @db.VarChar(128)
  expiresAt      DateTime          @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([scope, keyHash])
  @@index([expiresAt])
}

enum MusicTrackScope {
  SYSTEM
  PERSONAL
}

enum MusicTrackStatus {
  DRAFT
  PROCESSING
  FAILED
  READY
  RETIRED
}

model MusicTrack {
  id               String           @id @default(uuid()) @db.Uuid
  ownerUserId      String?          @db.Uuid
  createdById      String           @db.Uuid
  scope            MusicTrackScope  @default(SYSTEM)
  status           MusicTrackStatus @default(DRAFT)
  displayName      String           @db.VarChar(160)
  artistName       String?          @db.VarChar(160)
  durationSeconds  Int?
  mimeType         String           @db.VarChar(128)
  sizeBytes        BigInt
  storageKey       String           @unique @db.VarChar(512)
  licenseType      String?          @db.VarChar(80)
  licenseReference String?          @db.VarChar(500)
  creditText       String?          @db.VarChar(500)
  sortOrder        Int              @default(0)
  revision         Int              @default(1)
  retiredAt        DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  owner            User?            @relation("MusicTrackOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdBy        User             @relation("MusicTrackUploader", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([scope, status, sortOrder])
  @@index([ownerUserId, status, createdAt])
}

