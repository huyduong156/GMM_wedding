NODE_ENV=development
APP_ENV=local
PORT=3000
DB_ADMIN_PORT=8081
APP_ORIGIN=http://localhost:8080
DATABASE_URL=postgresql://gmm_wedding:gmm_wedding_local@localhost:5432/gmm_wedding?schema=public
AUTH_SECRET=replace-with-at-least-32-characters
