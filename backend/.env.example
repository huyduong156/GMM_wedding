NODE_ENV=development
APP_ENV=local
PORT=3000
DB_ADMIN_PORT=8081
APP_ORIGIN=http://localhost:8080
APP_ORIGINS=http://localhost:8080,http://localhost:5173
DATABASE_URL=postgresql://gmm_wedding:gmm_wedding_local@localhost:5432/gmm_wedding?schema=public
AUTH_SECRET=replace-with-at-least-32-characters
AUTH_TOKEN_ENCRYPTION_KEY=replace-with-another-at-least-32-character-secret
AUTH_RATE_LIMIT_SECRET=replace-with-a-third-at-least-32-character-secret
AUTH_RATE_LIMIT_DRIVER=disabled
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:5173/login?oauth=success
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@gmm-wedding.local
SMTP_USER=
SMTP_PASSWORD=
TRUST_PROXY=false
LOG_LEVEL=info
API_DOCS_ENABLED=true
MEDIA_STORAGE_DRIVER=s3
MEDIA_FAKE_ROOT=s3_upload_fake
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/api/media/fake-assets
# Change MEDIA_STORAGE_DRIVER to s3 or r2 when using object storage.
# Use http://minio:9000 when the backend runs inside Docker Compose.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=gmm-wedding
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# R2_ENDPOINT lấy trong Cloudflare R2 > S3 API, thay your-account-id bằng Account ID.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Custom domain public của bucket; để trống nếu chưa cấu hình public access.
R2_PUBLIC_BASE_URL=https://cdn.example.com
R2_BUCKET=gmm-wedding-dev
R2_REGION=auto
# Lấy từ R2 API Token có quyền Object Read & Write trên bucket dev.
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
DATABASE_QUERY_LOG_PARAMS=true
